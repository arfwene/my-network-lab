# =============================================================================
#  site.local.yml — 실제 환경 값 (git 에 올리지 않는다)
# =============================================================================
#  config/site.yml 위에 깊은 병합(deep merge)된다. 바꿀 값만 쓰면 된다.
#  이 파일을 `config/site.local.yml` 로 복사해서 사용할 것.
#
#  ▸ 아래 주소는 전부 **RFC5737 문서 전용 대역**(192.0.2.0/24 · 198.51.100.0/24 ·
#    203.0.113.0/24)이다. 실제로 존재하지 않는 주소이므로 그대로 두면 동작하지 않는다.
#    반드시 우리 환경 값으로 바꿔 쓸 것.
#
#  ▸ **이 예시 파일에 실제 사내 주소를 적지 말 것.** 이 파일은 git 에 올라간다
#    (`site.local.yml` 만 제외 대상이다). 사내 대역·호스트명이 여기 들어가면
#    저장소를 공개하는 순간 함께 나간다. `make check` 가 이 파일도 검사한다.
# =============================================================================

access:
  office_lan: 192.0.2.0/24              # 교육생 PC 가 있는 사무실 대역
  # Proxmox 접속 정보는 웹 콘솔 [관리자 → 연결 설정] 에서 입력해도 된다.
  #   웹에서 저장하면 var/runtime.yml 로 나가며 이 파일보다 우선한다.
  #   API 토큰은 어느 쪽이든 파일에 쓰지 않는다 (var/console.db + 환경변수).
  proxmox:
    host_ip:      192.0.2.10
    api_endpoint: "https://192.0.2.10:8006/"
    node_name:    pve01                 # Proxmox 에서 `hostname -s`
    datastore:    local-lvm
  jump_host:
    # 랩 운영 서버(= 점프 호스트)의 사무실 LAN 주소. 교육생 PC 에서 닿는 주소다.
    # 고정 IP 로 줄 것 — 바뀌면 배포해 둔 교육생 ssh 설정이 전부 죽는다.
    office_ip: 192.0.2.11
    # 이 서버가 관리망 브리지의 트렁크에 물려 있지 않다면 켠다.
    # proxy_via_proxmox: true
  # 운영 서버(Ansible)의 공개키만. install.sh 가 찍어 준 값을 넣는다.
  # 교육생 키는 여기가 아니라 콘솔 [접속 키] 에서 본인이 등록한다.
  ssh_public_keys:
    - "ssh-ed25519 AAAA... my-network-lab@labsrv"

# 사내에서 이미 사용 중인 대역을 여기에 등록한다.
# 랩 대역이 이것과 겹치면 validate-site.py 가 배포를 막는다.
#   ▸ 실제 사내 대역은 `site.local.yml` 에만 적는다. 여기(예시)에는 적지 말 것.
forbidden:
  - {cidr: 10.99.0.0/16, severity: error, reason: "사내 사용 중 — 실제 대역으로 바꿀 것"}
  # - {cidr: 10.98.0.0/16, severity: error, reason: "사내 데이터센터"}

# 사내 도메인·호스트명을 등록해 두면 공개 전 유출 검사가 잡아 준다.
#   ▸ 실제 값은 `site.local.yml` 에만. 아래는 형태만 보여 주는 주석이다.
publish_guard:
  forbidden_strings: []
    # - "사내도메인.example"
    # - "우리회사-내부호스트"
