#!/bin/bash
# =============================================================================
#  {{ node }} 스위칭 설정   (자동 생성 — 직접 수정하지 말 것)
#  단계: {{ lab_stage }}
#
#  이 스크립트를 그대로 읽으면 "스위치가 무엇을 하는가"가 보인다.
#    ip link ... master BR   = 포트를 스위치에 꽂는다
#    bridge vlan add ...     = 포트에 VLAN 을 할당한다 (access / trunk)
#
#  확인 명령:
#    bridge fdb show br {{ bridge_name_local }}    <- MAC 주소 테이블 (= show mac address-table)
#    bridge vlan show                     <- 포트별 VLAN 할당 (= show vlan brief)
#    bridge link show                     <- 포트 상태
# =============================================================================
set -uo pipefail
BR={{ bridge_name_local }}
{% set si = stages.index(config_stage | default(lab_stage)) %}
{% set vf = stage_override.switch_vlan_filtering | default(true) %}
{% set ports = lab_interfaces | selectattr('active') | selectattr('bridge_id') | map(attribute='name') | list %}

# ---------------------------------------------------------------------------
#  포트가 나타나기를 먼저 기다린다.
#
#  common 역할이 netplan 으로 NIC 이름을 바꾼다(MAC 기준). 그 handler 는
#  async·poll:0 으로 던져지고 ansible 은 SSH 가 돌아오는 것만 기다리므로,
#  관리망이 살아난 뒤에도 eth1·eth2 는 아직 이름이 바뀌는 중일 수 있다.
#  그 틈에 이 스크립트가 돌면 이렇게 된다:
#
#      Cannot find device "eth1"
#      Cannot find device "eth2"
#
#  그리고 **exit 0 이었다.** 포트 하나 없는 브리지가 NO-CARRIER 로 남았는데
#  systemd 는 성공이라고 했고, 교육생에게는 "pc1 에서 pc2 가 안 되는" 랩이 갔다.
#  스위치가 조용히 아무것도 안 하는 것보다 시끄럽게 실패하는 편이 낫다.
# ---------------------------------------------------------------------------
wait_dev() {
  local i="$1" n=0
  while [ "$n" -lt 60 ]; do            # 최대 30초
    [ -e "/sys/class/net/$i" ] && return 0
    sleep 0.5
    n=$((n + 1))
  done
  return 1
}

MISSING=""
for i in {{ ports | join(' ') }}; do
  wait_dev "$i" || MISSING="$MISSING $i"
done
if [ -n "$MISSING" ]; then
  echo "스위치 포트를 찾지 못했다:$MISSING" >&2
  echo "  NIC 이름이 바뀌는 중이었을 수 있다. 다시 시도하려면:" >&2
  echo "    systemctl restart lab-switch" >&2
  exit 1
fi

ip link show "$BR" >/dev/null 2>&1 || ip link add name "$BR" type bridge
{% if vf %}
# VLAN 필터링 ON — 포트마다 VLAN 을 할당해야 통신이 된다
ip link set "$BR" type bridge vlan_filtering 1 vlan_default_pvid 0
{% else %}
# VLAN 필터링 OFF — 모든 포트가 하나의 브로드캐스트 도메인 ({{ lab_stage }} 단계)
#   M2 에서 VLAN 이 도입되면 여기가 1 로 바뀌고, 두 PC 의 통신이 끊긴다.
ip link set "$BR" type bridge vlan_filtering 0
{% endif %}
# MAC 학습 에이징 타임. 단위는 1/100초이므로 30000 = 300초 (리눅스 기본값).
#   M1 에서 "테이블이 비면 다시 플러딩한다"를 관찰하려면 이 값을 3000(30초)으로 낮춘다.
ip link set "$BR" type bridge ageing_time 30000
ip link set "$BR" up

{% for i in lab_interfaces if i.active and i.bridge_id %}
{# 주석은 조건 블록으로 끝내면 안 된다. ansible 의 template 은 trim_blocks 가
   켜져 있어 블록 태그 뒤의 줄바꿈을 지운다 — 다음 줄이 주석에 붙어 버린다:
       # ---- eth1 -> r4 (access)ip link set eth1 up
   그러면 `ip link set eth1 up` 이 아예 실행되지 않는다. #}
# ---- {{ i.name }} -> {{ i.peer }}{% if i.mode %} ({{ i.mode }}){% endif %}{% if i.desc %}  {{ i.desc }}{% endif %}

ip link set {{ i.name }} up
ip link set {{ i.name }} master "$BR" || { echo "{{ i.name }} 포트를 $BR 에 꽂지 못했다" >&2; exit 1; }
{%   if vf %}
bridge vlan del dev {{ i.name }} vid 1 2>/dev/null || true
{%     if i.mode == 'access' %}
bridge vlan add dev {{ i.name }} vid {{ i.vlan }} pvid untagged
{%     elif i.mode == 'trunk' %}
{%       for v in i.vlan %}
bridge vlan add dev {{ i.name }} vid {{ v }}          # 태그된 VLAN
{%       endfor %}
bridge vlan add dev {{ i.name }} vid {{ i.native }} pvid untagged   # native VLAN (미사용 VLAN 지정 = 실무 관례)
{%     endif %}
{%   endif %}
{% endfor %}

# 정말 꽂혔는지 확인한다. 위 명령이 하나씩은 성공해도 결과가 비어 있을 수 있다 —
# "명령을 돌렸다" 와 "스위치가 됐다" 는 다른 말이다.
GOT=$(ls /sys/class/net/"$BR"/brif 2>/dev/null | wc -l)
WANT={{ ports | length }}
if [ "$GOT" -ne "$WANT" ]; then
  echo "$BR 에 포트가 $GOT/$WANT 개만 꽂혔다" >&2
  exit 1
fi

exit 0
