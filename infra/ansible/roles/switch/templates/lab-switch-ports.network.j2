# 자동 생성 (Ansible / roles/switch). 직접 수정하지 말 것.
#
#  이 스위치의 포트는 systemd-networkd 가 건드리지 않게 한다.
#
#  왜 필요한가
#    포트를 브리지에 꽂는 것은 lab-switch-up.sh 다. 그런데 netplan 이 만든
#    10-netplan-ethN.network 가 같은 포트를 소유하고 있으면, networkd 가
#    링크를 다시 잡을 때마다 브리지에서 도로 떼어 간다.
#
#      lab-switch.service: Finished
#      systemd-networkd: eth1: Reconfiguring with 10-netplan-eth1.network
#      systemd-networkd: br0: Lost carrier
#
#    같은 초에 벌어지고 아무 오류도 남지 않는다. 스위치는 "성공" 이라고 하고
#    브리지에는 포트가 하나도 없다. 관리 주체가 둘이라 생긴 일이다.
#
#  파일 이름이 05- 로 시작하는 것은 10-netplan-* 보다 먼저 읽히기 위해서다.
#  이름 바꾸기(set-name)는 .link 파일이 하므로 여기 영향을 받지 않는다.
[Match]
Name={{ ports | join(' ') }}

[Link]
Unmanaged=yes
