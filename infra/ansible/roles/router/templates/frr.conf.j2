! =============================================================================
!  {{ node }} — {{ desc }}
!  자동 생성 (Ansible / roles/router). 직접 수정하면 다음 배포에 덮어써진다.
!  단계: {{ lab_stage }}
!
!  확인 명령 (vtysh):
!    show ip route            <- 라우팅 테이블
!    show ip ospf neighbor    <- OSPF 인접
!    show ip ospf interface   <- 인터페이스별 area/cost
! =============================================================================
{% set si = stages.index(config_stage | default(lab_stage)) %}
{% set v6 = si >= stages.index('m5') %}
{% set m3 = stages.index('m3') %}
{% set m4 = stages.index('m4') %}
{% set m9 = stages.index('m9') %}
frr defaults traditional
hostname {{ node }}
log syslog informational
service integrated-vtysh-config
!  ※ 주석은 반드시 **자기 줄**에 둔다. FRR 은 줄 끝의 ! 를 명령의 일부로
!     읽어서 그 줄 전체를 거부한다 — 조용히, 오류 없이.
!       % Unknown command: ip route 10.10.32.0/19 10.10.64.2   ! Site-B
!     그 탓에 M3 정적 라우팅이 한 번도 올라간 적이 없었다.
!
{% if si >= m3 and si < m4 and static_routes_m3 %}
! ---- M3 : 정적 라우팅 ----------------------------------------------------
!  ※ 양방향으로 넣어야 통신이 된다. 한쪽만 넣으면 "가는 길은 있는데 오는 길이 없다".
{% for r in static_routes_m3 %}
! {{ r.desc }}
ip route {{ r.prefix }} {{ r.via }}
{% endfor %}
!
{% endif %}
{% if si >= m4 and ospf_enabled %}
! ---- M4 : OSPF -----------------------------------------------------------
{% for i in lab_interfaces if i.active and i.ipv4 is defined and i.role in ['p2p', 'gateway', 'loopback'] %}
interface {{ i.name }}
{% if i.desc %} description {{ i.desc }}
{% endif %}
 ip ospf area {{ routing.ospf.area }}
{% if i.name in ospf_passive or i.role | default('') == 'loopback' %}
! 사용자·서버망·루프백 — Hello 를 보낼 이유가 없다
 ip ospf passive
{% endif %}
{% if i.ospf_cost is defined %}
! 주 경로 10 / 백업 100
 ip ospf cost {{ i.ospf_cost }}
{% endif %}
{% if v6 and i.ipv6 is defined %}
 ipv6 ospf6 area {{ routing.ospf6.area }}
{% if i.role in ['gateway', 'loopback'] or i.name in ospf_passive %}
 ipv6 ospf6 passive
{% endif %}
{% endif %}
!
{% endfor %}
router ospf
 ospf router-id {{ loopback_ipv4 }}
! passive 는 위 interface 절의 `ip ospf passive` 가 정한다.
! `passive-interface <이름>` 은 FRR 8 에서 deprecated 다 — VRF 를 못 가리기 때문이다.
{% if si >= m9 and edge_routing.ospf_default_originate | default(false) %}
! 내부 라우터들이 기본 경로를 학습한다
 default-information originate
{% endif %}
!
{% if v6 %}
router ospf6
 ospf6 router-id {{ loopback_ipv4 }}
!
{% endif %}
{% endif %}
{% if si >= m9 and edge_routing.static is defined %}
! ---- M9 : 인터넷 경계 ----------------------------------------------------
!  경계는 IGP 로 풀지 않는다. 실무에서도 정적 default 또는 BGP 를 쓴다.
{% for r in edge_routing.static if r.via %}
! {{ r.desc }}
ip route {{ r.prefix }} {{ r.via }}
{% endfor %}
{% endif %}
!
line vty
!
