#!/bin/bash
# lab-whereami — 내 인터페이스가 어느 링크에 붙어 있는가
# Proxmox 는 토폴로지를 시각적으로 보여주지 않으므로 이 스크립트가 그 역할을 한다.
#
# 주소는 **지금 올라가 있는 값**을 읽는다. 설계값을 그대로 찍으면, 설정이
# 아직 안 올라간 랩에서도 주소가 있는 것처럼 보인다 — 그게 제일 나쁘다.
cat <<'BANNER'
{{ node }} ({{ node_role }}) — {{ desc }}
BANNER

live_addr() { ip -4 -br addr show dev "$1" 2>/dev/null | awk '{print $3}' | head -1; }
live_state() { cat "/sys/class/net/$1/operstate" 2>/dev/null || echo none; }

missing=0
# 머리글은 printf 로 채우지 않고 손으로 맞춘다.
#   printf 의 %-10s 는 **글자 수**로 채우는데 한글은 터미널에서 두 칸을 쓴다.
#   그래서 `인터페이스`(5자 = 10칸)와 `mgmt0`(5자 = 5칸)이 같은 폭으로 채워지고
#   표가 눈에 띄게 어긋난다. 아래 공백은 그 두 칸을 계산해 넣은 것이다.
#   본문 칸은 전부 ASCII 라 %-10s 로 맞는다 — 그래서 상대노드에도 한글을 쓰지 않는다.
printf '\n%s\n' "인터페이스 상태     주소                 상대노드       설명"
printf '%s\n' "-------------------------------------------------------------------------------"
m=$(live_addr {{ mgmt_interface }})
printf '%-10s %-8s %-20s %-14s %s\n' "{{ mgmt_interface }}" \
  "$(live_state {{ mgmt_interface }})" \
  "${m:--}" "-" "관리망(OOB) — 통신 테스트에 쓰지 말 것"
{% for i in lab_interfaces if i.active %}
a=$(live_addr {{ i.name }})
{# 조건 블록은 반드시 자기 줄을 차지해야 한다.
   ansible 의 template 모듈은 trim_blocks 가 켜져 있어 블록 태그 뒤의 줄바꿈을
   지운다. 한 줄에 몰아 쓰면 이렇게 붙어 버린다:

       [ -z "$a" ] && missing=1printf '%-10s ...

   주소가 있으면 && 가 끊어져 printf 가 아예 실행되지 않는다. 그래서 이 표에
   관리망 한 줄만 나오고 랩 인터페이스는 한 줄도 안 보였다 — 교육생이 자기
   장비를 파악하는 첫 화면인데. #}
{% if i.ipv4 is defined and i.ipv4 %}
[ -z "$a" ] && missing=1
{% endif %}
printf '%-10s %-8s %-20s %-14s %s\n' "{{ i.name }}" \
  "$(live_state {{ i.name }})" "${a:--}" "{{ i.peer | default('-') }}" \
  "{{ i.desc | default(i.role | default('', true), true) }}{% if i.vlan is defined and i.vlan %} [VLAN {{ i.vlan }}]{% endif %}"
{% endfor %}
echo
if [ "$missing" = 1 ]; then
  echo "이 노드에 아직 주소가 없습니다 — 설정이 안 올라간 상태입니다."
  echo "웹 콘솔에서 [이 모듈 적용] 을 누르면 올라갑니다 (1분쯤)."
  echo
fi
echo "설계 단계: {{ lab_stage }}   |   전체 지도: 웹 콘솔 [랩 지도]"
