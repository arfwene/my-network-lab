__pycache__/
*.pyc

# ---- 실제 환경 값 (사내 IP·키). 절대 커밋하지 않는다 ----
config/site.local.yml
#  손으로 뜬 사본(.bak, .orig, 날짜 붙인 것)도 같은 값이 들어 있다.
#  실제로 서버에 site.local.yml.bak 이 추적되지 않은 채 놓여 있었다.
config/site.local.yml.*
!config/site.local.yml.example

# ---- 테스트 환경 접속 정보 (사내 IP·계정·비밀번호). 절대 커밋하지 않는다 ----
.testenv/

# ---- 생성물 (config/site.yml 에서 언제든 다시 만들 수 있다) ----
#  실제 환경 값이 박혀 있으므로 저장소에 올리지 않는다.
dist/
infra/ansible/inventory/lab*/
# main.tf 까지 gen-tfvars / gen-mgmt 가 생성한다 (_template · _mgmt 만 커밋)
infra/terraform/envs/lab*/
infra/terraform/envs/mgmt/

# ---- Terraform ----
.terraform/
*.tfstate
*.tfstate.*
terraform.tfvars
crash.log

# ---- 웹 콘솔 ----
console/.venv/
console/__pycache__/

# ---- 운영 데이터 (재생성 불가. make clean 이 건드리지 않는다) ----
#  계정 DB, 세션 시크릿, 랩 진행 상태
var/
config/users.yml*

# Xshell 세션 파일 — 접속 정보와 비밀번호가 들어 있다.
# 참고용으로 받아 둔 남의 세션이 딸려 올라가지 않게 막는다.
# 우리가 만드는 것은 dist/ 아래로 나가므로 이 규칙과 무관하다.
*.xsh
