# 웹 콘솔 서비스 유닛 (템플릿).
#   install.sh --service 가 @USER@ · @ROOT@ · @PORT@ 를 채워
#   /etc/systemd/system/my-network-lab.service 로 설치한다.
#
# 손으로 설치할 때:
#   sed -e 's|@USER@|lab|g' -e 's|@GROUP@|lab|g' \
#       -e 's|@ROOT@|/opt/my-network-lab|g' -e 's|@PORT@|8080|g' \
#       deploy/my-network-lab.service | sudo tee /etc/systemd/system/my-network-lab.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now my-network-lab

[Unit]
Description=my-network-lab 웹 콘솔
Documentation=file://@ROOT@/docs/DEPLOY.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# root 로 돌리지 않는다. 이 서비스는 Terraform·Ansible 을 자식 프로세스로 띄우는데,
# root 로 돌면 생성물(dist/ · inventory/ · var/)이 전부 root 소유가 되어
# 관리자가 CLI 로 같은 저장소를 만질 수 없게 된다.
User=@USER@
Group=@GROUP@
WorkingDirectory=@ROOT@

# Terraform 은 /usr/local/bin 에 설치된다. systemd 기본 PATH 에는 들어 있지 않을 수 있다.
Environment=PATH=@ROOT@/console/.venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
# 사내 프록시·Proxmox SSH 설정처럼 서버마다 다른 값은 이 파일에 둔다 (없어도 된다).
EnvironmentFile=-@ROOT@/var/console.env

ExecStart=@ROOT@/console/.venv/bin/uvicorn app:app --app-dir console --host 0.0.0.0 --port @PORT@

Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30

# --- 최소한의 격리 -----------------------------------------------------------
#  랩 작업 자체가 SSH·HTTPS 로 나가야 하므로 네트워크는 막지 않는다.
#  /usr · /boot · /etc 는 읽기 전용으로 둔다 — 랩 운영이 시스템을 고칠 일은 없다.
#  홈 디렉토리는 막지 않는다: Ansible 이 ~/.ansible/cp 에 SSH 다중화 소켓을,
#  Terraform 이 ~/.terraform.d 에 프로바이더 캐시를 쓴다. 막으면 작업이 실패한다.
#  NoNewPrivileges 는 **켜지 않는다.** 켜면 sudo 가 아예 동작하지 않는다
#  ("no new privileges" flag is set, which prevents sudo from running as root).
#  콘솔은 [점프 계정 적용]·[이 서버를 관리망에 연결] 을 root 소유 헬퍼
#  두 개로 실행한다 — 인자 없는 sudoers 규칙으로 그 둘만 허용해 두었다.
#  이걸 켜 두면 두 버튼이 화면에 **뜨지도 않는다**. 콘솔은 조용히
#  "복사할 명령" 안내로 되돌아가고, 아무도 왜인지 알 수 없다.
#  실제로 그래서 --service 로 설치한 서버에서는 점프 계정 버튼이 한 번도
#  나온 적이 없었다. 권한 축소는 sudoers 쪽에서 한다 — 거기가 정확하다.
PrivateTmp=yes
#  ProtectSystem 은 full 이 아니라 true 다. full 은 /etc 까지 읽기 전용으로 만드는데,
#  그 마운트 네임스페이스는 sudo 로 띄운 자식에게도 그대로 상속된다. 그래서 root
#  헬퍼가 root 인데도 파일을 못 쓴다:
#      OSError: [Errno 30] Read-only file system: '/etc/netplan/60-lab-mgmt.yaml'
#  두 헬퍼가 쓰는 곳이 전부 /etc 다 — netplan · sshd_config.d · useradd(passwd·shadow).
#  /usr 와 /boot 는 계속 읽기 전용으로 둔다.
#  덧붙여, /etc 를 잠그는 것은 여기서 별 뜻이 없다. 콘솔은 일반 계정으로 돌기 때문에
#  애초에 /etc 를 못 쓴다. 실제로 권한을 가르는 것은 sudoers 쪽이다.
ProtectSystem=true
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
