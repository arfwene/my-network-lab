r1(config-if)# ipv6 address {{ p2p6['r1-r3'].addresses.r1 }}/64
r1(config-if)# exit
r1(config)# interface lo0
r1(config-if)# ipv6 address {{ loopback6.r1 }}
r1(config-if)# end
```

```
