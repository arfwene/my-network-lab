cols: [r1, [r2, r3], r4]
links:
  - { a: r1, b: r2, tone: dash, label: Hello 만 나간다 }
  - { a: r1, b: r3, tone: dash, label: Hello 만 나간다 }
  - { a: r2, b: r4, tone: dash }
  - { a: r3, b: r4, tone: dash }
marks:
  r1: ["OSPF 켬", "이웃 0"]
  r2: ["아직 없음"]
